{
  "manifest_version": 3,
  "name": "ScreenShot Turbo",
  "version": "1.1.0",
  "description": "Extensão profissional e rápida de captura, recorte, edição e exportação de tela para Chrome e Edge.",
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "unlimitedStorage",
    "downloads",
    "scripting"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/Icon16.png",
      "32": "icons/Icon32.png",
      "48": "icons/Icon48.png",
      "128": "icons/Icon128.png"
    },
    "default_title": "ScreenShot Turbo"
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Abrir o menu ScreenShot Turbo"
    },
    "capture-visible": {
      "suggested_key": {
        "default": "Alt+Shift+V"
      },
      "description": "Capturar janela visível"
    },
    "capture-full-page": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Capturar página inteira"
    },
    "capture-selection": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Iniciar seleção livre"
    },
    "capture-ratio-1-1": {
      "description": "Seleção com proporção 1:1"
    },
    "capture-ratio-3-2": {
      "description": "Seleção com proporção 3:2"
    },
    "capture-ratio-4-3": {
      "description": "Seleção com proporção 4:3"
    },
    "capture-ratio-5-4": {
      "description": "Seleção com proporção 5:4"
    },
    "capture-ratio-16-9": {
      "description": "Seleção com proporção 16:9"
    }
  },
  "options_ui": {
    "page": "settings/settings.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/Icon16.png",
    "32": "icons/Icon32.png",
    "48": "icons/Icon48.png",
    "64": "icons/Icon64.png",
    "128": "icons/Icon128.png",
    "256": "icons/Icon256.png",
    "512": "icons/Icon512.png"
  }
}